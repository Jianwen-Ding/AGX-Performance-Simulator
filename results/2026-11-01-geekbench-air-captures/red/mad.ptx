.version 7.0
.target sm_75
.address_size 64
// 8 independent integer chains per thread, ITERS rounds (mad); writes the sum
.visible .entry c(.param .u64 out, .param .u32 iters, .param .u32 a)
{
	.reg .u32 %r<24>;
	.reg .u64 %rd<4>;
	.reg .pred %p;
	ld.param.u32 %r1, [iters];
	ld.param.u32 %r2, [a];
	mov.u32 %r3, %tid.x;
	add.u32 %r8, %r3, 1;
	add.u32 %r9, %r3, 8;
	add.u32 %r10, %r3, 15;
	add.u32 %r11, %r3, 22;
	add.u32 %r12, %r3, 29;
	add.u32 %r13, %r3, 36;
	add.u32 %r14, %r3, 43;
	add.u32 %r15, %r3, 50;
	mov.u32 %r4, 0;
LOOP:
	mad.lo.u32 %r8, %r8, %r2, 3;
	mad.lo.u32 %r9, %r9, %r2, 4;
	mad.lo.u32 %r10, %r10, %r2, 5;
	mad.lo.u32 %r11, %r11, %r2, 6;
	mad.lo.u32 %r12, %r12, %r2, 7;
	mad.lo.u32 %r13, %r13, %r2, 8;
	mad.lo.u32 %r14, %r14, %r2, 9;
	mad.lo.u32 %r15, %r15, %r2, 10;
	add.u32 %r4, %r4, 1;
	setp.lt.u32 %p, %r4, %r1;
	@%p bra LOOP;
	add.u32 %r8, %r8, %r9;
	add.u32 %r8, %r8, %r10;
	add.u32 %r8, %r8, %r11;
	add.u32 %r8, %r8, %r12;
	add.u32 %r8, %r8, %r13;
	add.u32 %r8, %r8, %r14;
	add.u32 %r8, %r8, %r15;
	ld.param.u64 %rd1, [out];
	mov.u32 %r5, %ctaid.x;
	mov.u32 %r6, %ntid.x;
	mad.lo.u32 %r7, %r5, %r6, %r3;
	mul.wide.u32 %rd2, %r7, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.global.u32 [%rd3], %r8;
	ret;
}
