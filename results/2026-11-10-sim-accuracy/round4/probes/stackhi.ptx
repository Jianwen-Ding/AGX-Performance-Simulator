.version 7.0
.target sm_75
.address_size 64
// High-intensity stack probe: per trip 8 lane-uniform stack loads (consecutive words from 8*i, masked) summed,
// then (st != 0) 4 stack stores; 1 KiB .local array (footprint 4 * (mask + 1) bytes per thread).
.visible .entry stackhi(.param .u64 out, .param .u32 iters, .param .u32 mask, .param .u32 st)
{
	.local .align 4 .b8 arr[1024];
	.reg .u32 %r<64>;
	.reg .u64 %rd<64>;
	.reg .pred %p<3>;
	mov.u32 %r1, %tid.x;
	mov.u32 %r2, %ctaid.x;
	mov.u32 %r3, %ntid.x;
	mad.lo.u32 %r4, %r2, %r3, %r1;
	ld.param.u32 %r5, [iters];
	ld.param.u32 %r11, [mask];
	ld.param.u32 %r12, [st];
	setp.ne.u32 %p2, %r12, 0;
	mov.u64 %rd1, arr;
	mov.u32 %r6, 0;
fill:
	mul.wide.u32 %rd2, %r6, 4;
	add.u64 %rd3, %rd1, %rd2;
	st.local.u32 [%rd3], %r1;
	add.u32 %r6, %r6, 1;
	setp.lt.u32 %p1, %r6, 256;
	@%p1 bra fill;
	mov.u32 %r6, 0;
	mov.u32 %r10, 0;
loop:
	mul.lo.u32 %r7, %r6, 8;
	add.u32 %r20, %r7, 0;
	and.b32 %r20, %r20, %r11;
	mul.wide.u32 %rd10, %r20, 4;
	add.u64 %rd10, %rd1, %rd10;
	ld.local.u32 %r30, [%rd10];
	add.u32 %r21, %r7, 1;
	and.b32 %r21, %r21, %r11;
	mul.wide.u32 %rd11, %r21, 4;
	add.u64 %rd11, %rd1, %rd11;
	ld.local.u32 %r31, [%rd11];
	add.u32 %r22, %r7, 2;
	and.b32 %r22, %r22, %r11;
	mul.wide.u32 %rd12, %r22, 4;
	add.u64 %rd12, %rd1, %rd12;
	ld.local.u32 %r32, [%rd12];
	add.u32 %r23, %r7, 3;
	and.b32 %r23, %r23, %r11;
	mul.wide.u32 %rd13, %r23, 4;
	add.u64 %rd13, %rd1, %rd13;
	ld.local.u32 %r33, [%rd13];
	add.u32 %r24, %r7, 4;
	and.b32 %r24, %r24, %r11;
	mul.wide.u32 %rd14, %r24, 4;
	add.u64 %rd14, %rd1, %rd14;
	ld.local.u32 %r34, [%rd14];
	add.u32 %r25, %r7, 5;
	and.b32 %r25, %r25, %r11;
	mul.wide.u32 %rd15, %r25, 4;
	add.u64 %rd15, %rd1, %rd15;
	ld.local.u32 %r35, [%rd15];
	add.u32 %r26, %r7, 6;
	and.b32 %r26, %r26, %r11;
	mul.wide.u32 %rd16, %r26, 4;
	add.u64 %rd16, %rd1, %rd16;
	ld.local.u32 %r36, [%rd16];
	add.u32 %r27, %r7, 7;
	and.b32 %r27, %r27, %r11;
	mul.wide.u32 %rd17, %r27, 4;
	add.u64 %rd17, %rd1, %rd17;
	ld.local.u32 %r37, [%rd17];
	add.u32 %r40, %r30, %r31;
	add.u32 %r40, %r40, %r32;
	add.u32 %r40, %r40, %r33;
	add.u32 %r40, %r40, %r34;
	add.u32 %r40, %r40, %r35;
	add.u32 %r40, %r40, %r36;
	add.u32 %r40, %r40, %r37;
	add.u32 %r10, %r10, %r40;
	@!%p2 bra skip;
	add.u32 %r41, %r40, 0;
	st.local.u32 [%rd10], %r41;
	add.u32 %r42, %r40, 1;
	st.local.u32 [%rd12], %r42;
	add.u32 %r43, %r40, 2;
	st.local.u32 [%rd14], %r43;
	add.u32 %r44, %r40, 3;
	st.local.u32 [%rd16], %r44;
skip:
	add.u32 %r6, %r6, 1;
	setp.lt.u32 %p1, %r6, %r5;
	@%p1 bra loop;
	ld.param.u64 %rd4, [out];
	mul.wide.u32 %rd5, %r4, 4;
	add.u64 %rd6, %rd4, %rd5;
	st.global.u32 [%rd6], %r10;
	ret;
}
