#version 450
// Base64 decoding with validation (MIME / JSON payloads): each thread maps one 4-character quantum through the
// inverse alphabet, writes its 3 bytes (fewer for '=' padding in the last quantum) and flags quanta holding
// characters outside the alphabet or misplaced padding. Integer-exact.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer T { uint8_t text[]; };
layout(std430, binding = 1) writeonly buffer O { uint8_t outp[]; };
layout(std430, binding = 2) writeonly buffer V { uint bad[]; };
layout(push_constant) uniform P { uint quanta; } p;

uint val(uint c) {
    if (c >= 65u && c <= 90u) return c - 65u;
    if (c >= 97u && c <= 122u) return c - 71u;
    if (c >= 48u && c <= 57u) return c + 4u;
    if (c == 43u) return 62u;
    if (c == 47u) return 63u;
    return c == 61u ? 64u : 255u;                       // '=' -> 64, anything else invalid
}

void main() {
    uint q = gl_GlobalInvocationID.x;
    if (q >= p.quanta) return;
    uint v0 = val(uint(text[4u * q])), v1 = val(uint(text[4u * q + 1u])), v2 = val(uint(text[4u * q + 2u])), v3 = val(uint(text[4u * q + 3u]));
    bool last = q + 1u == p.quanta;
    bool ok = v0 < 64u && v1 < 64u && (v2 < 64u || (last && v2 == 64u && v3 == 64u)) && (v3 < 64u || (last && v3 == 64u));
    uint w = ((v0 & 63u) << 18) | ((v1 & 63u) << 12) | ((v2 & 63u) << 6) | (v3 & 63u);
    if (!ok) w = 0u;
    outp[3u * q] = uint8_t(w >> 16);
    if (v2 != 64u || !ok) outp[3u * q + 1u] = uint8_t(w >> 8);
    if (v3 != 64u || !ok) outp[3u * q + 2u] = uint8_t(w);
    bad[q] = ok ? 0u : 1u;
}
