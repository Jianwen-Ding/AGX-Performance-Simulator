#version 450
// AES-128 encryption (ECB), one 16-byte block per thread: SubBytes through an S-box in shared memory, ShiftRows,
// MixColumns (xtime), AddRoundKey with the 11 round keys expanded on the host. State as 16 bytes in registers.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer B { uint blocks[]; };   // 4 words per block (bytes in memory order)
layout(std430, binding = 1) readonly buffer K { uint rk[44]; };     // round keys, bytes in memory order per word
layout(std430, binding = 2) readonly buffer S { uint sbox_in[256]; };
layout(std430, binding = 3) writeonly buffer O { uint outp[]; };
layout(push_constant) uniform P { uint n; } p;
shared uint sbox[256];

uint xt(uint b) { return ((b << 1) ^ ((b & 0x80u) != 0u ? 0x1bu : 0u)) & 0xffu; }

void main() {
    uint t = gl_LocalInvocationID.x;
    for (uint k = t; k < 256u; k += 64u) sbox[k] = sbox_in[k];
    barrier();
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint s[16];
    for (uint w = 0u; w < 4u; w++) {
        uint v = blocks[4u * i + w] ^ rk[w];
        for (uint b = 0u; b < 4u; b++) s[4u * w + b] = (v >> (8u * b)) & 0xffu;
    }
    for (uint r = 1u; r <= 10u; r++) {
        uint u[16];
        for (uint c = 0u; c < 4u; c++)                        // SubBytes + ShiftRows: row j shifts left by j
            for (uint j = 0u; j < 4u; j++) u[4u * c + j] = sbox[s[4u * ((c + j) & 3u) + j]];
        for (uint c = 0u; c < 4u; c++) {
            uint a0 = u[4u * c], a1 = u[4u * c + 1u], a2 = u[4u * c + 2u], a3 = u[4u * c + 3u];
            if (r < 10u) {                                    // MixColumns (not in the last round)
                uint all = a0 ^ a1 ^ a2 ^ a3;
                s[4u * c] = a0 ^ all ^ xt(a0 ^ a1);
                s[4u * c + 1u] = a1 ^ all ^ xt(a1 ^ a2);
                s[4u * c + 2u] = a2 ^ all ^ xt(a2 ^ a3);
                s[4u * c + 3u] = a3 ^ all ^ xt(a3 ^ a0);
            } else {
                s[4u * c] = a0; s[4u * c + 1u] = a1; s[4u * c + 2u] = a2; s[4u * c + 3u] = a3;
            }
            uint key = rk[4u * r + c];
            for (uint b = 0u; b < 4u; b++) s[4u * c + b] ^= (key >> (8u * b)) & 0xffu;
        }
    }
    for (uint w = 0u; w < 4u; w++)
        outp[4u * i + w] = s[4u * w] | s[4u * w + 1u] << 8 | s[4u * w + 2u] << 16 | s[4u * w + 3u] << 24;
}
