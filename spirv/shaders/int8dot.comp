#version 450
// int8 matrix product with int32 accumulation: C (M x N) = A (M x K, int8) * B (K x N, int8) through 8-bit storage
// (sign-extending byte loads), one output per thread, 16 x 16 workgroups.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer A { int8_t a[]; };
layout(std430, binding = 1) readonly buffer B { int8_t b[]; };
layout(std430, binding = 2) writeonly buffer C { int c[]; };
layout(push_constant) uniform P { uint M; uint N; uint K; } p;

void main() {
    uint col = gl_GlobalInvocationID.x, row = gl_GlobalInvocationID.y;
    if (row >= p.M || col >= p.N) return;
    int acc = 0;
    for (uint k = 0u; k < p.K; k++) acc += int(a[row * p.K + k]) * int(b[k * p.N + col]);
    c[row * p.N + col] = acc;
}
