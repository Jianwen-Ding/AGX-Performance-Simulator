#version 450
// Open-addressing hash table (linear probing) built with atomicCompSwap, then queried:
// mode 0: insert key[i] -> value[i] (keys unique, never 0xffffffff = empty)
// mode 1: look up query[i] -> its value, or 0xffffffff when absent
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer K { uint keys[]; };
layout(std430, binding = 1) readonly buffer V { uint vals[]; };
layout(std430, binding = 2) buffer T { uint table[]; };        // 2 words per slot: key, value
layout(std430, binding = 3) readonly buffer Q { uint queries[]; };
layout(std430, binding = 4) writeonly buffer R { uint result[]; };
layout(push_constant) uniform P { uint mode; uint n; uint mask; } p;

uint hash(uint k) { k ^= k >> 16; k *= 0x7feb352du; k ^= k >> 15; k *= 0x846ca68bu; k ^= k >> 16; return k; }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    if (p.mode == 0u) {
        uint k = keys[i], slot = hash(k) & p.mask;
        for (uint probe = 0u; probe <= p.mask; probe++) {
            uint prev = atomicCompSwap(table[2u * slot], 0xffffffffu, k);
            if (prev == 0xffffffffu || prev == k) { table[2u * slot + 1u] = vals[i]; return; }
            slot = (slot + 1u) & p.mask;
        }
    } else {
        uint k = queries[i], slot = hash(k) & p.mask, r = 0xffffffffu;
        for (uint probe = 0u; probe <= p.mask; probe++) {
            uint t = table[2u * slot];
            if (t == k) { r = table[2u * slot + 1u]; break; }
            if (t == 0xffffffffu) break;
            slot = (slot + 1u) & p.mask;
        }
        result[i] = r;
    }
}
