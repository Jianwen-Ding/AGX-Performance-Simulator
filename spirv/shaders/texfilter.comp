#version 450
// Hardware bilinear filtering (every textured pixel in graphics): an RGBA8 texture sampled with a linear,
// clamp-to-edge sampler at arbitrary normalized coordinates. Vulkan lets the weights be quantized to the device's
// sub-texel precision (at least 4 bits); the check reports which precision the results match. Verified on the
// hardware against the reference only (the simulator does not model the texture unit).
layout(local_size_x = 256) in;
layout(binding = 0) uniform sampler2D tex;
layout(std430, binding = 1) readonly buffer Q { vec2 uv[]; };
layout(std430, binding = 2) writeonly buffer O { vec4 rgba[]; };
layout(push_constant) uniform P { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    rgba[i] = textureLod(tex, uv[i], 0.0);
}
