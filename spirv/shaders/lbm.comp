#version 450
// Lattice-Boltzmann (D2Q9, BGK) on a periodic nx x ny grid, one time step per dispatch (pull streaming then
// collision); distributions in structure-of-arrays layout, ping-pong between buffer halves (src half = push.src).
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer Fd { float f[]; };            // 2 halves x 9 x nx x ny
layout(push_constant) uniform P { int nx; int ny; uint src; float omega; } p;

const int CX[9] = int[](0, 1, 0, -1, 0, 1, -1, -1, 1);
const int CY[9] = int[](0, 0, 1, 0, -1, 1, 1, -1, -1);
const float WQ[9] = float[](4.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0, 1.0 / 36.0, 1.0 / 36.0, 1.0 / 36.0, 1.0 / 36.0);

void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y);
    if (x >= p.nx || y >= p.ny) return;
    int cells = p.nx * p.ny;
    int so = int(p.src) * 9 * cells, dout = int(1u - p.src) * 9 * cells;
    float fi[9];
    float rho = 0.0, ux = 0.0, uy = 0.0;
    for (int i = 0; i < 9; i++) {
        int sx = (x - CX[i] + p.nx) % p.nx, sy = (y - CY[i] + p.ny) % p.ny;   // pull from the upstream neighbour
        fi[i] = f[so + i * cells + sy * p.nx + sx];
        rho += fi[i]; ux += fi[i] * float(CX[i]); uy += fi[i] * float(CY[i]);
    }
    ux /= rho; uy /= rho;
    float uu = ux * ux + uy * uy;
    for (int i = 0; i < 9; i++) {
        float cu = float(CX[i]) * ux + float(CY[i]) * uy;
        float feq = WQ[i] * rho * (1.0 + 3.0 * cu + 4.5 * cu * cu - 1.5 * uu);
        f[dout + i * cells + y * p.nx + x] = fi[i] + p.omega * (feq - fi[i]);
    }
}
