#version 450
// SipHash-2-4 (keyed hash against hash flooding: Rust's HashMap, Python's str hash before 3.11, the Linux kernel),
// one message per invocation: 64-bit add / rotate / xor rounds, 2 per 8-byte word and 4 to finalise, the last word
// carrying the remaining bytes and the length in its top byte. Lengths vary per lane (0-255 bytes).
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer M { uint64_t msg[]; };    // 32 words (256 bytes) per message slot
layout(std430, binding = 1) readonly buffer L { uint len[]; };
layout(std430, binding = 2) readonly buffer K { uint64_t key[2]; };
layout(std430, binding = 3) writeonly buffer H { uint64_t hout[]; };
layout(push_constant) uniform P { uint n; } p;

uint64_t rotl(uint64_t x, uint b) { return (x << b) | (x >> (64u - b)); }

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint64_t v0 = key[0] ^ 0x736f6d6570736575ul, v1 = key[1] ^ 0x646f72616e646f6dul;
    uint64_t v2 = key[0] ^ 0x6c7967656e657261ul, v3 = key[1] ^ 0x7465646279746573ul;
    uint n = len[i], full = n >> 3;
    for (uint w = 0u; w <= full; w++) {
        uint64_t m;
        if (w < full) m = msg[32u * i + w];
        else {                                                        // remaining bytes, length in the top byte
            uint rem = n & 7u;
            m = rem == 0u ? 0ul : msg[32u * i + w] & ((1ul << (8u * rem)) - 1ul);
            m |= uint64_t(n & 255u) << 56;
        }
        v3 ^= m;
        for (int r = 0; r < 2; r++) {
            v0 += v1; v1 = rotl(v1, 13u); v1 ^= v0; v0 = rotl(v0, 32u);
            v2 += v3; v3 = rotl(v3, 16u); v3 ^= v2;
            v0 += v3; v3 = rotl(v3, 21u); v3 ^= v0;
            v2 += v1; v1 = rotl(v1, 17u); v1 ^= v2; v2 = rotl(v2, 32u);
        }
        v0 ^= m;
    }
    v2 ^= 0xfful;
    for (int r = 0; r < 4; r++) {
        v0 += v1; v1 = rotl(v1, 13u); v1 ^= v0; v0 = rotl(v0, 32u);
        v2 += v3; v3 = rotl(v3, 16u); v3 ^= v2;
        v0 += v3; v3 = rotl(v3, 21u); v3 ^= v0;
        v2 += v1; v1 = rotl(v1, 17u); v1 ^= v2; v2 = rotl(v2, 32u);
    }
    hout[i] = v0 ^ v1 ^ v2 ^ v3;
}
