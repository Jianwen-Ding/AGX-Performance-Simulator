#version 450
// Closest-hit ray traversal of a bounding-volume hierarchy over a triangle mesh (ray tracing, collision and
// visibility queries): each invocation traces one ray, popping nodes from a short stack kept in shared memory (as
// GPU tracers do to stay out of scratch); inner nodes are kept when the ray's slab interval meets the box before the
// closest hit so far, leaves test their triangles with Moller-Trumbore. Output: triangle id (or ~0) and distance t.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer N { vec4 node[]; };       // 2 per node: (min, left or first), (max, count)
layout(std430, binding = 1) readonly buffer T { vec4 tri[]; };        // 3 per triangle (leaf order), w of v0 = id
layout(std430, binding = 2) readonly buffer R { vec4 ray[]; };        // 2 per ray: origin, direction
layout(std430, binding = 3) writeonly buffer H { vec2 hit[]; };       // (id bits, t)
layout(push_constant) uniform P { uint nrays; } p;
shared uint stk[64 * 48];

void main() {
    uint r = gl_GlobalInvocationID.x, base = 48u * gl_LocalInvocationID.x;
    if (r >= p.nrays) return;
    vec3 o = ray[2u * r].xyz, d = ray[2u * r + 1u].xyz, inv = 1.0 / d;
    float best = 3.0e38; uint bid = 0xffffffffu;
    uint sp = 0u; stk[base] = 0u; sp = 1u;
    while (sp > 0u) {
        uint ni = stk[base + --sp];
        vec4 a = node[2u * ni], b = node[2u * ni + 1u];
        vec3 t0 = (a.xyz - o) * inv, t1 = (b.xyz - o) * inv;
        vec3 tn = min(t0, t1), tf = max(t0, t1);
        float tin = max(max(tn.x, tn.y), max(tn.z, 0.0)), tout = min(min(tf.x, tf.y), tf.z);
        if (tin > tout || tin > best) continue;
        uint count = floatBitsToUint(b.w), first = floatBitsToUint(a.w);
        if (count == 0u) {                                            // inner: children at first, first + 1
            if (sp + 2u <= 48u) { stk[base + sp++] = first; stk[base + sp++] = first + 1u; }
            continue;
        }
        for (uint k = first; k < first + count; k++) {
            vec3 v0 = tri[3u * k].xyz, e1 = tri[3u * k + 1u].xyz - v0, e2 = tri[3u * k + 2u].xyz - v0;
            vec3 pv = cross(d, e2);
            float det = dot(e1, pv);
            if (abs(det) < 1e-12) continue;
            float id_ = 1.0 / det;
            vec3 tv = o - v0;
            float u = dot(tv, pv) * id_;
            if (u < 0.0 || u > 1.0) continue;
            vec3 qv = cross(tv, e1);
            float v = dot(d, qv) * id_;
            if (v < 0.0 || u + v > 1.0) continue;
            float t = dot(e2, qv) * id_;
            if (t > 1e-6 && t < best) { best = t; bid = floatBitsToUint(tri[3u * k].w); }
        }
    }
    hit[r] = vec2(uintBitsToFloat(bid), bid == 0xffffffffu ? 0.0 : best);
}
