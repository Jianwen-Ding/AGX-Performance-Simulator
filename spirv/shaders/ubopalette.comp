#version 450
// Matrix palette from a uniform buffer (skeletal animation, instancing): each vertex is transformed by one of 64
// mat4 in a 4 KiB UBO, chosen by a per-vertex index (a dynamically indexed uniform array). Integer-valued
// matrices and positions keep fp32 exact. Uniform buffers take a different path from storage buffers on AGX
// (the driver may preload them into uniform registers).
layout(local_size_x = 64) in;
layout(std140, binding = 0) uniform U { mat4 bones[64]; } u;
layout(std430, binding = 1) readonly buffer V { vec4 pos[]; };
layout(std430, binding = 2) readonly buffer B { uint bone[]; };
layout(std430, binding = 3) writeonly buffer O { vec4 outp[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    outp[i] = u.bones[bone[i] & 63u] * pos[i];
}
