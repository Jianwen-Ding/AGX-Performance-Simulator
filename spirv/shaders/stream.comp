#version 450
// Memory bandwidth by kernel kind: McCalpin's STREAM (Copy c = a, Scale b = s c, Add c = a + b, Triad a = b + s c)
// plus a pure read (per-workgroup sums of a) and a pure write (fill d) over fp32 arrays far larger than the SLC. Each
// dispatch's time gives that kind's bandwidth: with Read against Fill and Copy it separates read, write and
// write-back costs (applications note 67).
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) buffer B { float b[]; };
layout(std430, binding = 2) buffer C { float c[]; };
layout(std430, binding = 3) buffer D { float d[]; };
layout(std430, binding = 4) writeonly buffer S { float sums[]; };
layout(push_constant) uniform P { uint kind; uint n; float s; } p;
shared float red[256];

void main() {
    uint i = gl_GlobalInvocationID.x, l = gl_LocalInvocationID.x;
    if (p.kind == 4u) {                                               // read: 16 elements per invocation, summed
        float t = 0.0;
        for (uint k = 0u; k < 16u; k++) { uint j = (gl_WorkGroupID.x * 16u + k) * 256u + l; if (j < p.n) t += a[j]; }
        red[l] = t;
        barrier();
        for (uint w = 128u; w > 0u; w >>= 1) { if (l < w) red[l] += red[l + w]; barrier(); }
        if (l == 0u) sums[gl_WorkGroupID.x] = red[0];
        return;
    }
    if (i >= p.n) return;
    if (p.kind == 0u) c[i] = a[i];
    else if (p.kind == 1u) b[i] = p.s * c[i];
    else if (p.kind == 2u) c[i] = a[i] + b[i];
    else if (p.kind == 3u) a[i] = b[i] + p.s * c[i];
    else d[i] = float(i & 1023u);                                     // kind 5: fill
}
