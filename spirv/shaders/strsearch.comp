#version 450
// Substring search (grep): every thread tests whether an 8-byte pattern starts at its text position, writes a
// match flag, counts matches with atomicAdd and keeps the first match with atomicMin. Byte loads at unaligned
// offsets; integer-exact.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer T { uint8_t text[]; };
layout(std430, binding = 1) readonly buffer P { uint8_t pat[8]; };
layout(std430, binding = 2) writeonly buffer F { uint8_t flags[]; };
layout(std430, binding = 3) buffer R { uint count; uint first; };
layout(push_constant) uniform PC { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    bool hit = i + 8u <= p.n;
    for (uint k = 0u; k < 8u && hit; k++) hit = text[i + k] == pat[k];
    flags[i] = uint8_t(hit ? 1u : 0u);
    if (hit) {
        atomicAdd(count, 1u);
        atomicMin(first, i);
    }
}
