#version 450
// A small ray tracer: three spheres on a ground plane, one directional light with hard shadows, Lambert shading and
// one mirror bounce; writes an RGBA8 image (packUnorm4x8). One thread per pixel, 8 x 8 workgroups.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) writeonly buffer O { uint img[]; };
layout(push_constant) uniform P { uint width; uint height; } p;

const vec4 S[3] = vec4[](vec4(-1.2, 1.0, 5.0, 1.0), vec4(1.1, 0.7, 4.2, 0.7), vec4(0.2, 0.4, 2.8, 0.4));
const vec3 C[3] = vec3[](vec3(0.9, 0.2, 0.2), vec3(0.2, 0.8, 0.3), vec3(0.3, 0.4, 0.95));
const vec3 L = vec3(0.4472136, 0.8944272, -0.0);

// nearest hit along ro + t rd: t (or -1), normal, colour, reflectivity
float hit(vec3 ro, vec3 rd, out vec3 n, out vec3 col, out float refl) {
    float best = 1e30;
    n = vec3(0.0); col = vec3(0.0); refl = 0.0;
    for (int i = 0; i < 3; i++) {
        vec3 oc = ro - S[i].xyz;
        float b = dot(oc, rd), c = dot(oc, oc) - S[i].w * S[i].w, h = b * b - c;
        if (h < 0.0) continue;
        float t = -b - sqrt(h);
        if (t > 1e-3 && t < best) { best = t; n = (ro + t * rd - S[i].xyz) / S[i].w; col = C[i]; refl = i == 2 ? 0.6 : 0.1; }
    }
    if (rd.y < 0.0) {                                    // ground plane y = 0, checkerboard
        float t = -ro.y / rd.y;
        if (t > 1e-3 && t < best) {
            best = t; n = vec3(0.0, 1.0, 0.0);
            vec3 q = ro + t * rd;
            // checkerboard up to distance 20, uniform beyond (far squares alias: any rounding difference flips them)
            col = t > 20.0 ? vec3(0.55) : ((int(floor(q.x)) + int(floor(q.z))) & 1) == 0 ? vec3(0.8) : vec3(0.3);
            refl = 0.2;
        }
    }
    return best < 1e30 ? best : -1.0;
}

vec3 shade(vec3 ro, vec3 rd, out vec3 hp, out vec3 hn, out float refl, out bool any) {
    vec3 n, col;
    float t = hit(ro, rd, n, col, refl);
    any = t > 0.0;
    if (!any) return vec3(0.5, 0.7, 1.0) * (0.6 + 0.4 * rd.y);   // sky
    hp = ro + t * rd; hn = n;
    vec3 sn, sc; float sr;
    float lit = hit(hp + n * 1e-3, L, sn, sc, sr) > 0.0 ? 0.0 : max(dot(n, L), 0.0);
    return col * (0.15 + 0.85 * lit);
}

void main() {
    uvec2 g = gl_GlobalInvocationID.xy;
    if (g.x >= p.width || g.y >= p.height) return;
    vec2 uv = (vec2(g) + 0.5) / vec2(p.width, p.height) * 2.0 - 1.0;
    uv.x *= float(p.width) / float(p.height);
    vec3 ro = vec3(0.0, 1.0, -1.0), rd = normalize(vec3(uv.x, -uv.y, 1.5));
    vec3 hp, hn; float refl; bool any;
    vec3 c = shade(ro, rd, hp, hn, refl, any);
    if (any && refl > 0.0) {
        vec3 rd2 = reflect(rd, hn), hp2, hn2; float r2; bool a2;
        c = mix(c, shade(hp + hn * 1e-3, rd2, hp2, hn2, r2, a2), refl);
    }
    img[g.y * p.width + g.x] = packUnorm4x8(vec4(clamp(c, 0.0, 1.0), 1.0));
}
