#version 450
// scrypt's ROMix (RFC 7914), the memory-hard core of the scrypt password hash / key derivation, with r = 1: per
// invocation, a 128-byte block X is mixed N times while each state is stored in a scratchpad V of N blocks, then
// mixed N more times with V[Integerify(X) mod N] xor-ed in: data-dependent random reads over 128 KiB per hash
// (N = 1024). BlockMix is two Salsa20/8 cores. The host runs PBKDF2-HMAC-SHA256 before and after (scrypt's
// cheap parts). The scratchpad is interleaved across invocations (word w of block i of invocation t at
// (i * 32 + w) * T + t), as GPU implementations lay it out, so the first pass's stores coalesce.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer B { uint blk[]; };       // per invocation: 32 words in, 32 words out
layout(std430, binding = 1) buffer V { uint pad[]; };       // N * 32 * T words
layout(push_constant) uniform P { uint n; uint T; } p;

#define R(a, b) (((a) << (b)) | ((a) >> (32 - (b))))

void salsa8(inout uint b[16]) {
    uint x[16] = b;
    for (int i = 0; i < 8; i += 2) {
        x[ 4] ^= R(x[ 0] + x[12],  7); x[ 8] ^= R(x[ 4] + x[ 0],  9);
        x[12] ^= R(x[ 8] + x[ 4], 13); x[ 0] ^= R(x[12] + x[ 8], 18);
        x[ 9] ^= R(x[ 5] + x[ 1],  7); x[13] ^= R(x[ 9] + x[ 5],  9);
        x[ 1] ^= R(x[13] + x[ 9], 13); x[ 5] ^= R(x[ 1] + x[13], 18);
        x[14] ^= R(x[10] + x[ 6],  7); x[ 2] ^= R(x[14] + x[10],  9);
        x[ 6] ^= R(x[ 2] + x[14], 13); x[10] ^= R(x[ 6] + x[ 2], 18);
        x[ 3] ^= R(x[15] + x[11],  7); x[ 7] ^= R(x[ 3] + x[15],  9);
        x[11] ^= R(x[ 7] + x[ 3], 13); x[15] ^= R(x[11] + x[ 7], 18);
        x[ 1] ^= R(x[ 0] + x[ 3],  7); x[ 2] ^= R(x[ 1] + x[ 0],  9);
        x[ 3] ^= R(x[ 2] + x[ 1], 13); x[ 0] ^= R(x[ 3] + x[ 2], 18);
        x[ 6] ^= R(x[ 5] + x[ 4],  7); x[ 7] ^= R(x[ 6] + x[ 5],  9);
        x[ 4] ^= R(x[ 7] + x[ 6], 13); x[ 5] ^= R(x[ 4] + x[ 7], 18);
        x[11] ^= R(x[10] + x[ 9],  7); x[ 8] ^= R(x[11] + x[10],  9);
        x[ 9] ^= R(x[ 8] + x[11], 13); x[10] ^= R(x[ 9] + x[ 8], 18);
        x[12] ^= R(x[15] + x[14],  7); x[13] ^= R(x[12] + x[15],  9);
        x[14] ^= R(x[13] + x[12], 13); x[15] ^= R(x[14] + x[13], 18);
    }
    for (int i = 0; i < 16; i++) b[i] += x[i];
}

// BlockMix with r = 1: Y0 = Salsa(B1 ^ B0), Y1 = Salsa(Y0 ^ B1); the result is Y0 || Y1
void blockmix(inout uint a[16], inout uint b[16]) {
    for (int i = 0; i < 16; i++) a[i] ^= b[i];
    salsa8(a);
    for (int i = 0; i < 16; i++) b[i] ^= a[i];
    salsa8(b);
}

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= p.T) return;
    uint a[16], b[16];
    for (int i = 0; i < 16; i++) { a[i] = blk[t * 32u + uint(i)]; b[i] = blk[t * 32u + 16u + uint(i)]; }
    for (uint i = 0u; i < p.n; i++) {
        for (int w = 0; w < 16; w++) {
            pad[(i * 32u + uint(w)) * p.T + t] = a[w];
            pad[(i * 32u + 16u + uint(w)) * p.T + t] = b[w];
        }
        blockmix(a, b);
    }
    for (uint i = 0u; i < p.n; i++) {
        uint j = b[0] & (p.n - 1u);                                    // Integerify: first word of the last 64 bytes
        for (int w = 0; w < 16; w++) {
            a[w] ^= pad[(j * 32u + uint(w)) * p.T + t];
            b[w] ^= pad[(j * 32u + 16u + uint(w)) * p.T + t];
        }
        blockmix(a, b);
    }
    for (int i = 0; i < 16; i++) { blk[t * 32u + uint(i)] = a[i]; blk[t * 32u + 16u + uint(i)] = b[i]; }
}
