#version 450
// Private-memory pressure: a 96-word per-thread array indexed with data-dependent indices (the compiler has to
// keep it in scratch / stack memory or index registers indirectly), a permutation walk over it and a checksum.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer I { uint inp[]; };   // 4 words per thread: seed, steps, 2 spare
layout(std430, binding = 1) writeonly buffer O { uint o[]; };    // 4 words per thread
layout(push_constant) uniform P { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint s = inp[4u * i], steps = inp[4u * i + 1u] & 255u;
    uint a[96];
    for (uint k = 0u; k < 96u; k++) { s = s * 1664525u + 1013904223u; a[k] = s; }
    uint idx = s % 96u, acc = 0u;
    for (uint k = 0u; k < steps; k++) {
        uint v = a[idx];
        a[idx] = v ^ (v >> 7) ^ k;
        acc = acc * 31u + v;
        idx = (v + k) % 96u;
    }
    uint x = 0u;
    for (uint k = 0u; k < 96u; k++) x ^= a[k] * (k + 1u);
    o[4u * i] = acc; o[4u * i + 1u] = x; o[4u * i + 2u] = idx; o[4u * i + 3u] = a[(acc ^ x) % 96u];
}
