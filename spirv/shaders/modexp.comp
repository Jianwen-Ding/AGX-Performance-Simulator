#version 450
// Modular exponentiation base^exp mod m for 32-bit operands by square-and-multiply with 64-bit products (the core
// of RSA / Diffie-Hellman / primality tests, here at 32 bits): 32 dependent mulmod steps per lane. Integer-exact.
#extension GL_ARB_gpu_shader_int64 : require
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer I { uvec4 args[]; };     // base, exp, mod, unused
layout(std430, binding = 1) writeonly buffer O { uint res[]; };
layout(push_constant) uniform P { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint64_t m = uint64_t(args[i].z), b = uint64_t(args[i].x) % m, r = 1ul % m;
    uint e = args[i].y;
    while (e != 0u) {
        if ((e & 1u) != 0u) r = r * b % m;
        b = b * b % m;
        e >>= 1;
    }
    res[i] = uint(r);
}
