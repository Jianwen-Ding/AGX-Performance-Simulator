#version 450
// 64-bit integer kernel: splitmix64 of each 64-bit seed (multiply, shifts, xor), plus a signed 64-bit product and
// arithmetic shift, a 64-bit unsigned compare/select and a 64-bit add with carry across the halves.
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer S { uint64_t seed[]; };
layout(std430, binding = 1) readonly buffer A { int a[]; };
layout(std430, binding = 2) writeonly buffer O { uint64_t o[]; };
layout(push_constant) uniform P { uint n; } p;

uint64_t splitmix64(uint64_t x) {
    uint64_t z = x + 0x9E3779B97F4A7C15ul;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ul;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EBul;
    return z ^ (z >> 31);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uint64_t s = seed[i];
    uint64_t h = splitmix64(s);
    int64_t prod = int64_t(a[2u * i]) * int64_t(a[2u * i + 1u]);
    o[4u * i] = h;
    o[4u * i + 1u] = uint64_t(prod >> 7);
    o[4u * i + 2u] = h > s ? h - s : s - h;
    o[4u * i + 3u] = s + uint64_t(uint(a[2u * i]));
}
