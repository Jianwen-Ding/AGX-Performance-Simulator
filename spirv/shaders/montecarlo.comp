#version 450
// Monte Carlo estimate of pi: each thread draws 64 points from a counter-based PCG hash, counts those inside the
// quarter circle with exact 15-bit integer coordinates, stores its count, and the subgroup sum is added to a global
// counter by one elected lane (subgroup arithmetic + atomics). Integer-exact.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
layout(local_size_x = 128) in;
layout(std430, binding = 0) writeonly buffer C { uint counts[]; };
layout(std430, binding = 1) buffer T { uint total; };
layout(push_constant) uniform P { uint n; uint seed; } p;

uint pcg(uint v) {
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint c = 0u;
    if (i < p.n) {
        for (uint k = 0u; k < 64u; k++) {
            uint h = pcg((i * 64u + k) ^ p.seed);
            uint x = h & 32767u, y = (h >> 15) & 32767u;
            c += (x * x + y * y < (1u << 30)) ? 1u : 0u;
        }
        counts[i] = c;
    }
    uint s = subgroupAdd(c);
    if (subgroupElect()) atomicAdd(total, s);
}
