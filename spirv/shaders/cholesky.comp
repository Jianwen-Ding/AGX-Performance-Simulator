#version 450
// Batched Cholesky factorisation A = L L^T of 16 x 16 symmetric positive-definite matrices (Kalman filters,
// Gaussian processes, batched least squares): one workgroup per matrix, one invocation per element, right-looking:
// for each column k, l_kk = sqrt(a_kk); the column below is divided by it; the trailing lower triangle takes the
// rank-1 update a_ij -= l_ik l_jk. Three barriers per column. fp32; the upper triangle of L is written as 0.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer A { float a[]; };
layout(std430, binding = 1) writeonly buffer L { float l[]; };
shared float m[16][17];

void main() {
    uint j = gl_LocalInvocationID.x, i = gl_LocalInvocationID.y, base = 256u * gl_WorkGroupID.x;
    m[i][j] = a[base + 16u * i + j];
    barrier();
    for (uint k = 0u; k < 16u; k++) {
        if (i == k && j == k) m[k][k] = sqrt(m[k][k]);
        barrier();
        if (j == k && i > k) m[i][k] /= m[k][k];
        barrier();
        if (j > k && i >= j) m[i][j] -= m[i][k] * m[j][k];
        barrier();
    }
    l[base + 16u * i + j] = j <= i ? m[i][j] : 0.0;
}
