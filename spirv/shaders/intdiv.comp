#version 450
// Integer division and conversions: unsigned / and % by a variable divisor and by constants (the compiler's
// multiply-by-reciprocal lowering), signed / (truncating) on non-overflowing operands, and int <-> float
// conversions (correctly rounded in Vulkan).
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer I { uvec4 inp[]; };   // a, b (non-zero), signed a, signed b (non-zero)
layout(std430, binding = 1) writeonly buffer O { uint o[]; };
layout(push_constant) uniform P { uint n; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    uvec4 v = inp[i];
    uint a = v.x, b = v.y;
    int sa = int(v.z), sb = int(v.w);
    uint base = 12u * i;
    o[base + 0u] = a / b;
    o[base + 1u] = a % b;
    o[base + 2u] = a / 7u;
    o[base + 3u] = a % 1000u;
    o[base + 4u] = a / 65537u;
    o[base + 5u] = uint(sa / sb);
    o[base + 6u] = uint(sa / 3);
    o[base + 7u] = floatBitsToUint(float(a));
    o[base + 8u] = floatBitsToUint(float(sa));
    o[base + 9u] = uint(uintBitsToFloat((b & 0x007fffffu) | 0x4b000000u));   // [2^23, 2^24): exact float -> uint
    o[base + 10u] = uint(int(uintBitsToFloat((v.w & 0x807fffffu) | 0x49000000u)));  // +-[2^19, 2^20) -> int (trunc)
    o[base + 11u] = uint(sa >> 3) ^ (a >> 29);
}
