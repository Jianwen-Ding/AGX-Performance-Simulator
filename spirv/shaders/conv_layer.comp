#version 450
// One convolutional-network layer: out[k][y][x] = relu(bias[k] + sum_{c,dy,dx} w[k][c][dy][dx] * in[c][y+dy-1][x+dx-1])
// (3 x 3 kernels, zero padding, CHW layout). One thread per output value: x, y from a 16 x 16 workgroup, k from z.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer I { float inp[]; };
layout(std430, binding = 1) readonly buffer Wt { float w[]; };
layout(std430, binding = 2) readonly buffer B { float bias[]; };
layout(std430, binding = 3) writeonly buffer O { float outp[]; };
layout(push_constant) uniform P { int width; int height; int cin; } p;

void main() {
    int x = int(gl_GlobalInvocationID.x), y = int(gl_GlobalInvocationID.y), k = int(gl_GlobalInvocationID.z);
    if (x >= p.width || y >= p.height) return;
    float acc = bias[k];
    for (int c = 0; c < p.cin; c++)
        for (int dy = 0; dy < 3; dy++) {
            int yy = y + dy - 1;
            if (yy < 0 || yy >= p.height) continue;
            for (int dx = 0; dx < 3; dx++) {
                int xx = x + dx - 1;
                if (xx < 0 || xx >= p.width) continue;
                acc = fma(w[((k * p.cin + c) * 3 + dy) * 3 + dx], inp[(c * p.height + yy) * p.width + xx], acc);
            }
        }
    outp[(k * p.height + y) * p.width + x] = max(acc, 0.0);
}
