#version 450
// Conway's Game of Life on a toroidal W x H grid, one generation per dispatch; the two generations ping-pong between
// the halves of one buffer (src half = push.src). Cells are 0 / 255 bytes so the final grid is directly an image.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer G { uint8_t cells[]; };   // 2 * W * H
layout(push_constant) uniform P { int width; int height; uint src; } p;

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= p.width || g.y >= p.height) return;
    uint so = p.src * uint(p.width * p.height), dout = (1u - p.src) * uint(p.width * p.height);
    int n = 0;
    for (int dy = -1; dy <= 1; dy++)
        for (int dx = -1; dx <= 1; dx++) {
            if (dx == 0 && dy == 0) continue;
            int x = (g.x + dx + p.width) % p.width, y = (g.y + dy + p.height) % p.height;
            n += cells[so + uint(y * p.width + x)] != uint8_t(0) ? 1 : 0;
        }
    bool alive = cells[so + uint(g.y * p.width + g.x)] != uint8_t(0);
    cells[dout + uint(g.y * p.width + g.x)] = (n == 3 || (alive && n == 2)) ? uint8_t(255) : uint8_t(0);
}
