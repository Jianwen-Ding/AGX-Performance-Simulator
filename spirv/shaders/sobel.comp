#version 450
// Sobel edge detection on an 8-bit greyscale image (bytes through 8-bit storage), 16 x 16 tiles with a one-pixel
// halo in shared memory, clamped borders; output magnitude min(|gx| + |gy|, 255) as bytes. Integer-exact.
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly buffer I { uint8_t src[]; };
layout(std430, binding = 1) writeonly buffer O { uint8_t dst[]; };
layout(push_constant) uniform P { int width; int height; } p;
shared int tile[18][18];

void main() {
    ivec2 l = ivec2(gl_LocalInvocationID.xy), o = ivec2(gl_WorkGroupID.xy) * 16;
    for (int k = l.y * 16 + l.x; k < 324; k += 256) {
        ivec2 t = ivec2(k % 18, k / 18);
        ivec2 s = clamp(o + t - 1, ivec2(0), ivec2(p.width - 1, p.height - 1));
        tile[t.y][t.x] = int(src[s.y * p.width + s.x]);
    }
    barrier();
    ivec2 g = o + l;
    if (g.x >= p.width || g.y >= p.height) return;
    int x = l.x + 1, y = l.y + 1;
    int gx = -tile[y - 1][x - 1] - 2 * tile[y][x - 1] - tile[y + 1][x - 1] + tile[y - 1][x + 1] + 2 * tile[y][x + 1] + tile[y + 1][x + 1];
    int gy = -tile[y - 1][x - 1] - 2 * tile[y - 1][x] - tile[y - 1][x + 1] + tile[y + 1][x - 1] + 2 * tile[y + 1][x] + tile[y + 1][x + 1];
    dst[g.y * p.width + g.x] = uint8_t(min(abs(gx) + abs(gy), 255));
}
