#version 450
// One AdamW optimiser step (the fused elementwise update training frameworks run after each backward pass), in
// place over fp32 parameters, gradients and both moments: m = b1 m + (1 - b1) g, v = b2 v + (1 - b2) g^2, bias
// corrections for step t, p -= lr (m_hat / (sqrt(v_hat) + eps) + wd p). Memory bound: 16 bytes read, 12 written.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Pa { float prm[]; };
layout(std430, binding = 1) readonly buffer Gr { float grd[]; };
layout(std430, binding = 2) buffer M1 { float m1[]; };
layout(std430, binding = 3) buffer M2 { float m2[]; };
layout(push_constant) uniform P { uint n; float lr; float b1; float b2; float eps; float wd; float bc1; float bc2; } p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    float g = grd[i];
    float m = p.b1 * m1[i] + (1.0 - p.b1) * g;
    float v = p.b2 * m2[i] + (1.0 - p.b2) * g * g;
    m1[i] = m; m2[i] = v;
    float mh = m / p.bc1, vh = v / p.bc2;                              // bc = 1 - beta^t
    float w = prm[i];
    prm[i] = w - p.lr * (mh / (sqrt(vh) + p.eps) + p.wd * w);
}
