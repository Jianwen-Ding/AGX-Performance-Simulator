.version 7.0
.target sm_75
.address_size 64
.visible .entry dv(.param .u64 pout, .param .u32 d, .param .u32 iters)
{
    .reg .u32 %i, %d, %n, %x, %k, %t;
    .reg .u64 %b, %o;
    .reg .pred %p;
    mov.u32 %i, %ctaid.x;
    mad.lo.u32 %i, %i, %ntid.x, %tid.x;
    ld.param.u32 %d, [d];
    ld.param.u32 %n, [iters];
    add.u32 %x, %i, %d;
    mov.u32 %k, 0;
LOOP:
    shr.u32 %t, %x, 3;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 4;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 5;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 6;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 7;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 3;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 4;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 5;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 6;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 7;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 3;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 4;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 5;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 6;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 7;
    xor.b32 %x, %x, %t;
    shr.u32 %t, %x, 3;
    xor.b32 %x, %x, %t;
    add.u32 %k, %k, 1;
    setp.lt.u32 %p, %k, %n;
    @%p bra LOOP;
    ld.param.u64 %b, [pout];
    cvta.to.global.u64 %b, %b;
    mul.wide.u32 %o, %i, 4;
    add.u64 %b, %b, %o;
    st.global.u32 [%b], %x;
    ret;
}
