.version 7.0
.target sm_75
.address_size 64
.visible .entry dv(.param .u64 pout, .param .u32 d, .param .u32 iters)
{
    .reg .u32 %i, %d, %n, %k;
    .reg .u64 %b, %o;
    .reg .pred %q;
    .reg .u32 %a<8>; .reg .f32 %f<8>;
    
    mov.u32 %i, %ctaid.x;
    mad.lo.u32 %i, %i, %ntid.x, %tid.x;
    ld.param.u32 %d, [d];
    ld.param.u32 %n, [iters];
    add.u32 %a0, %i, 0;
    add.u32 %a1, %i, 1;
    add.u32 %a2, %i, 2;
    add.u32 %a3, %i, 3;
    add.u32 %a4, %i, 4;
    add.u32 %a5, %i, 5;
    add.u32 %a6, %i, 6;
    add.u32 %a7, %i, 7;
    mov.u32 %k, 0;
LOOP:
    cvt.rn.f32.u32 %f0, %a0;
    cvt.rzi.u32.f32 %a0, %f0;
    cvt.rn.f32.u32 %f1, %a1;
    cvt.rzi.u32.f32 %a1, %f1;
    cvt.rn.f32.u32 %f2, %a2;
    cvt.rzi.u32.f32 %a2, %f2;
    cvt.rn.f32.u32 %f3, %a3;
    cvt.rzi.u32.f32 %a3, %f3;
    cvt.rn.f32.u32 %f4, %a4;
    cvt.rzi.u32.f32 %a4, %f4;
    cvt.rn.f32.u32 %f5, %a5;
    cvt.rzi.u32.f32 %a5, %f5;
    cvt.rn.f32.u32 %f6, %a6;
    cvt.rzi.u32.f32 %a6, %f6;
    cvt.rn.f32.u32 %f7, %a7;
    cvt.rzi.u32.f32 %a7, %f7;
    add.u32 %k, %k, 1;
    setp.lt.u32 %q, %k, %n;
    @%q bra LOOP;
    add.u32 %a0, %a0, %a1;
    add.u32 %a0, %a0, %a2;
    add.u32 %a0, %a0, %a3;
    add.u32 %a0, %a0, %a4;
    add.u32 %a0, %a0, %a5;
    add.u32 %a0, %a0, %a6;
    add.u32 %a0, %a0, %a7;
    ld.param.u64 %b, [pout];
    cvta.to.global.u64 %b, %b;
    mul.wide.u32 %o, %i, 4;
    add.u64 %b, %b, %o;
    st.global.u32 [%b], %a0;
    ret;
}
